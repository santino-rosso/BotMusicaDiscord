# Ejemplo de archivo .env - Renombra este archivo a .env y completa con tus datos

# Token de bot obtenido del Discord Developer Portal
TOKEN=tu_token_aqui

# ID de cliente (Application ID) de tu aplicación en Discord Developer Portal
CLIENT_ID=tu_client_id_aqui

# Opcional: ID de servidor para pruebas
# Si lo definís, los comandos se registran SOLO en ese servidor y aparecen al instante.
# Sin GUILD_ID se registran como comandos globales (tardan hasta 1 hora en aparecer).
# Para obtenerlo: activá el Modo Desarrollador en Discord > clic derecho en el servidor > Copiar ID.
# GUILD_ID=tu_guild_id_aqui

# Opcional: credenciales de Spotify Developer (https://developer.spotify.com/dashboard)
# Necesarias para reproducir playlists y álbumes de Spotify completos.
# Sin ellas, Spotify funciona a medias (solo canciones individuales).
SPOTIFY_CLIENT_ID=tu_spotify_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_spotify_client_secret_aqui
